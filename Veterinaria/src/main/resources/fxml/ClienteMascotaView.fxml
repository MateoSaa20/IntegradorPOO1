<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15.0" xmlns="http://javafx.com/fxml/1" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.veterinaria.controller.ClienteMascotaViewController"
      style="-fx-padding: 15;">

    <Label text="Gestión de Clientes y Mascotas" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <!-- SECCIÓN 1: CLIENTES -->
    <TitledPane text="Clientes" animated="false">
        <VBox spacing="10.0">
            <HBox spacing="10.0" alignment="CENTER_LEFT">
                <TextField fx:id="txtNombre" promptText="Nombre"/>
                <TextField fx:id="txtApellido" promptText="Apellido"/>
                <TextField fx:id="txtDni" promptText="DNI"/>
                <TextField fx:id="txtTelefono" promptText="Teléfono"/>
                <Button text="Guardar" onAction="#guardarCliente"/>
                <Button text="Editar" onAction="#editarCliente"/>
                <Button text="Eliminar" onAction="#eliminarCliente" style="-fx-background-color: #e74c3c; -fx-text-fill: white;"/>
            </HBox>

            <TableView fx:id="tablaClientes" prefHeight="180.0">
                <columns>
                    <TableColumn fx:id="colDni" text="DNI" prefWidth="100.0"/>
                    <TableColumn fx:id="colNombre" text="Nombre" prefWidth="150.0"/>
                    <TableColumn fx:id="colApellido" text="Apellido" prefWidth="150.0"/>
                    <TableColumn fx:id="colTelefono" text="Teléfono" prefWidth="120.0"/>
                </columns>
            </TableView>
        </VBox>
    </TitledPane>

    <!-- SECCIÓN 2: MASCOTAS DEL CLIENTE SELECCIONADO -->
    <TitledPane text="Mascotas del Cliente Seleccionado" animated="false">
        <VBox spacing="10.0">
            <HBox spacing="10.0" alignment="CENTER_LEFT">
                <TextField fx:id="txtMascotaNombre" promptText="Nombre Mascota"/>
                <ComboBox fx:id="cmbSexo" promptText="Sexo"/>
                <ComboBox fx:id="cmbRaza" promptText="Seleccionar Raza"/>
                <DatePicker fx:id="dpFechaNacimiento" promptText="Fecha Nacimiento"/>
                <Button text="Agregar Mascota" onAction="#guardarMascota"/>
                <Button text="Eliminar Mascota" onAction="#eliminarMascota" style="-fx-background-color: #e74c3c; -fx-text-fill: white;"/>
            </HBox>

            <TableView fx:id="tablaMascotas" prefHeight="180.0">
                <columns>
                    <TableColumn fx:id="colFicha" text="Nº Ficha" prefWidth="80.0"/>
                    <TableColumn fx:id="colMascotaNombre" text="Nombre" prefWidth="130.0"/>
                    <TableColumn fx:id="colRaza" text="Raza" prefWidth="120.0"/>
                    <TableColumn fx:id="colSexo" text="Sexo" prefWidth="90.0"/>
                    <TableColumn fx:id="colFechaNac" text="Fecha Nacimiento" prefWidth="120.0"/>
                </columns>
            </TableView>
        </VBox>
    </TitledPane>

</VBox>