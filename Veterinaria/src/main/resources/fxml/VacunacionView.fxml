<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="12.0" xmlns="http://javafx.com/fxml/1" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.veterinaria.controller.VacunacionViewController"
      styleClass="view">

    <Label text="Control de Vacunaciones" styleClass="page-title"/>
    <Label text="Mascotas con vacunas vencidas o por vencer (dentro del mes de aviso)" styleClass="text-muted"/>

    <TableView fx:id="tablaAlertas" prefHeight="300.0">
        <columns>
            <TableColumn fx:id="colMascota" text="Mascota" prefWidth="120.0"/>
            <TableColumn fx:id="colEspecie" text="Especie" prefWidth="90.0"/>
            <TableColumn fx:id="colDueno" text="Dueño" prefWidth="170.0"/>
            <TableColumn fx:id="colVacuna" text="Vacuna" prefWidth="150.0"/>
            <TableColumn fx:id="colEnfermedad" text="Enfermedad que previene" prefWidth="220.0"/>
            <TableColumn fx:id="colUltima" text="Última aplicación" prefWidth="120.0"/>
            <TableColumn fx:id="colProxima" text="Próxima dosis" prefWidth="110.0"/>
            <TableColumn fx:id="colDias" text="Días" prefWidth="80.0"/>
            <TableColumn fx:id="colEstado" text="Estado" prefWidth="90.0"/>
        </columns>
    </TableView>

    <HBox spacing="10.0">
        <Button text="Registrar vacunación" onAction="#mostrarFormulario"/>
    </HBox>

    <!-- Formulario de registro (se muestra al presionar el botón) -->
    <VBox fx:id="panelFormulario" spacing="10.0" visible="false" managed="false"
          styleClass="panel">
        <Label text="Registrar nueva vacunación" styleClass="section-title"/>
        <HBox spacing="10.0" alignment="CENTER_LEFT">
            <Label text="Mascota:"/>
            <ComboBox fx:id="cmbMascota" prefWidth="240.0"/>
            <Label text="Vacuna:"/>
            <ComboBox fx:id="cmbVacuna" prefWidth="220.0"/>
        </HBox>
        <HBox spacing="10.0" alignment="CENTER_LEFT">
            <Label text="Veterinario:"/>
            <ComboBox fx:id="cmbVeterinario" prefWidth="220.0"/>
            <Label text="Fecha:"/>
            <DatePicker fx:id="dpFecha" prefWidth="140.0"/>
            <Label text="Hora (HH:mm):"/>
            <TextField fx:id="txtHora" prefWidth="80.0" promptText="10:00"/>
        </HBox>
        <HBox spacing="10.0" alignment="CENTER_LEFT">
            <Label text="Laboratorio/Marca:"/>
            <TextField fx:id="txtLaboratorio" prefWidth="200.0" promptText="Ej: Zoetis"/>
            <Label text="Observaciones de dosis:"/>
            <TextField fx:id="txtObservacionesDosis" prefWidth="280.0" promptText="Ej: Refuerzo anual"/>
        </HBox>
        <HBox spacing="10.0">
            <Button text="Registrar" onAction="#registrar" styleClass="btn-success"/>
            <Button text="Cancelar" onAction="#ocultarFormulario"/>
        </HBox>
    </VBox>
</VBox>
