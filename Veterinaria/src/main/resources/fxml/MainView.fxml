<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="mainLayout" xmlns="http://javafx.com/fxml/1" xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="com.veterinaria.controller.MainViewController"
            prefHeight="680.0" prefWidth="1024.0">
    
    <!-- MENÚ LATERAL IZQUIERDO -->
    <left>
        <VBox spacing="15.0" styleClass="sidebar">
            <Label text="VETERINARIA" styleClass="sidebar-title"/>
            <Separator />
            <Button text="Clientes y Mascotas" onAction="#mostrarClientes" maxWidth="17976931348623157e308" styleClass="sidebar-item"/>
            <Button text="Gestión de Turnos" onAction="#mostrarTurnos" maxWidth="17976931348623157e308" styleClass="sidebar-item"/>
            <Button text="Atención de Turnos" onAction="#mostrarAtencion" maxWidth="17976931348623157e308" styleClass="sidebar-item"/>
            <Button text="Historial y Vacunas" onAction="#mostrarHistorial" maxWidth="17976931348623157e308" styleClass="sidebar-item"/>
            <Button text="Control de Vacunaciones" onAction="#mostrarVacunaciones" maxWidth="17976931348623157e308" styleClass="sidebar-item"/>
            <Separator />
            <Button text="Servicios" onAction="#mostrarServicios" maxWidth="17976931348623157e308" styleClass="sidebar-item"/>
            <Button text="Tipos de Vacuna" onAction="#mostrarTipoVacunas" maxWidth="17976931348623157e308" styleClass="sidebar-item"/>
            <Button text="Veterinarios" onAction="#mostrarVeterinarios" maxWidth="17976931348623157e308" styleClass="sidebar-item"/>
        </VBox>
    </left>

    <!-- ÁREA CENTRAL DONDE SE CAMBIAN LAS PANTALLAS -->
    <center>
        <StackPane fx:id="contentArea" styleClass="content">
            <Label text="Bienvenido al Sistema de Gestión Veterinaria" styleClass="welcome"/>
        </StackPane>
    </center>
</BorderPane>