<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15.0" xmlns="http://javafx.com/fxml/1" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.veterinaria.controller.ServicioViewController"
      style="-fx-padding: 15;">

    <Label text="Gestión de Servicios" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <TitledPane text="Servicios" animated="false">
        <VBox spacing="10.0">
            <!-- Fila superior: Carga de Datos del Servicio -->
            <HBox spacing="15.0" alignment="CENTER_LEFT">
                <HBox spacing="5.0" alignment="CENTER_LEFT">
                    <Label text="Tipo de Servicio:"/>
                    <ComboBox fx:id="cmbTipo" prefWidth="150.0"/>
                </HBox>

                <HBox spacing="5.0" alignment="CENTER_LEFT">
                    <Label text="Nombre:"/>
                    <TextField fx:id="txtNombre" prefWidth="180.0"/>
                </HBox>

                <HBox spacing="5.0" alignment="CENTER_LEFT">
                    <Label text="Precio ($):"/>
                    <TextField fx:id="txtPrecio" prefWidth="100.0"/>
                </HBox>

                <HBox spacing="5.0" alignment="CENTER_LEFT">
                    <Label text="Duración (min):"/>
                    <TextField fx:id="txtDuracion" prefWidth="110.0"/>
                </HBox>

                <HBox fx:id="boxTipoVacuna" spacing="5.0" alignment="CENTER_LEFT" visible="false" managed="false">
                    <Label text="Vacuna:"/>
                    <ComboBox fx:id="cmbTipoVacuna" prefWidth="150.0"/>
                </HBox>
            </HBox>

            <!-- Tabla de Servicios -->
            <TableView fx:id="tablaServicios" prefHeight="320.0">
                <columns>
                    <TableColumn fx:id="colNombre" text="Nombre" prefWidth="220.0"/>
                    <TableColumn fx:id="colTipo" text="Tipo" prefWidth="130.0"/>
                    <TableColumn fx:id="colPrecio" text="Precio" prefWidth="100.0"/>
                    <TableColumn fx:id="colDuracion" text="Duración" prefWidth="100.0"/>
                    <TableColumn fx:id="colVacuna" text="Vacuna" prefWidth="160.0"/>
                </columns>
            </TableView>

            <!-- Fila inferior: Botones -->
            <HBox spacing="10.0" alignment="CENTER_RIGHT">
                <Button text="Guardar Servicio" onAction="#guardarServicio"/>
                <Button text="Editar Servicio" onAction="#editarServicio"/>
                <Button text="Eliminar Servicio" onAction="#eliminarServicio" style="-fx-background-color: #e74c3c; -fx-text-fill: white;"/>
            </HBox>
        </VBox>
    </TitledPane>
</VBox>
