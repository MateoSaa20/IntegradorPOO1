<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15.0" xmlns="http://javafx.com/fxml/1" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.veterinaria.controller.TipoVacunaViewController"
      styleClass="view">

    <Label text="Tipos de Vacuna" styleClass="page-title"/>

    <TitledPane text="Carga de Tipos de Vacuna" animated="false">
        <VBox spacing="10.0">
            <!-- Fila superior: Carga de Datos -->
            <HBox spacing="15.0" alignment="CENTER_LEFT">
                <HBox spacing="5.0" alignment="CENTER_LEFT">
                    <Label text="Nombre Comercial:"/>
                    <TextField fx:id="txtNombreComercial" prefWidth="180.0"/>
                </HBox>

                <HBox spacing="5.0" alignment="CENTER_LEFT">
                    <Label text="Enfermedad que Previene:"/>
                    <TextField fx:id="txtEnfermedad" prefWidth="280.0"/>
                </HBox>

                <HBox spacing="5.0" alignment="CENTER_LEFT">
                    <Label text="Periodicidad (meses):"/>
                    <TextField fx:id="txtPeriodicidad" prefWidth="150.0"/>
                </HBox>

                <HBox spacing="5.0" alignment="CENTER_LEFT">
                    <CheckBox fx:id="chkCiclica" text="¿Cíclica?"/>
                </HBox>
            </HBox>

            <!-- Tabla de Tipos de Vacuna -->
            <TableView fx:id="tablaTipoVacunas" prefHeight="320.0">
                <columns>
                    <TableColumn fx:id="colNombreComercial" text="Nombre Comercial" prefWidth="220.0"/>
                    <TableColumn fx:id="colEnfermedad" text="Enfermedad que Previene" prefWidth="320.0"/>
                    <TableColumn fx:id="colPeriodicidad" text="Periodicidad (meses)" prefWidth="160.0"/>
                    <TableColumn fx:id="colCiclica" text="¿Cíclica?" prefWidth="100.0"/>
                </columns>
            </TableView>

            <!-- Fila inferior: Botones -->
            <HBox spacing="10.0" alignment="CENTER_RIGHT">
                <Button text="Guardar Tipo de Vacuna" onAction="#guardarTipoVacuna"/>
                <Button text="Editar" onAction="#editarTipoVacuna"/>
                <Button text="Eliminar" onAction="#eliminarTipoVacuna" styleClass="btn-danger"/>
            </HBox>
        </VBox>
    </TitledPane>
</VBox>
